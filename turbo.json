{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build:pkg": {
      "dependsOn": [
        "^build:pkg"
      ],
      "outputs": [
        "dist/**",
        "dist-type-bundles/**"
      ],
      "outputLogs": "errors-only"
    },
    "build:app": {
      "dependsOn": [
        "^build:app",
        "build:pkg"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**",
        "out/**"
      ],
      "outputLogs": "new-only"
    },
    "types": {},
    "test": {},
    "lint": {},
    "publint": {},
    "dev:pkg": {
      "cache": false,
      "persistent": true
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    }
  }
}
