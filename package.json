{
  "name": "villagekit",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "build:app": "turbo build:app",
    "build:pkg": "turbo build:pkg",
    "dev:pkg": "tsx ./watch.ts",
    "dev:app": "turbo dev:app",
    "dev": "concurrently 'npm:dev:*'",
    "lint": "turbo lint",
    "format": "biome check --apply .",
    "format:unsafe": "biome check --apply-unsafe .",
    "test": "turbo test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.6.1",
    "@tauri-apps/cli": "^1.5.9",
    "@types/node": "^20.11.17",
    "@villagekit/tsconfig": "*",
    "concurrently": "^8.2.2",
    "patch-package": "^8.0.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "turbo": "^1.12.5",
    "turbotree": "^1.0.1",
    "turbowatch": "^2.29.4",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "^4.3.1"
  },
  "workspaces": [
    "dev/*",
    "core/*",
    "util/*",
    "parts/*",
    "products/*",
    "apps/*"
  ],
  "overrides": {
    "three": "^0.150.1"
  }
}
